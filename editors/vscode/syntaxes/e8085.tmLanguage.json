{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "8085 Assembly",
  "scopeName": "source.e8085",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#text_segment" },
    { "include": "#data_segment" },
    { "include": "#bss_segment" },
    { "include": "#segments" },
    { "include": "#modular_keywords" },
    { "include": "#characters" },
    { "include": "#strings" },
    { "include": "#types" },
    { "include": "#labels" },
    { "include": "#control_instructions" },
    { "include": "#memory_instructions" },
    { "include": "#mnemonics" },
    { "include": "#macro_calls" },
    { "include": "#var_declarations" },
    { "include": "#registers" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#local_variables" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.e8085",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(%(?i:macro))\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+([0-9]+))?",
          "captures": {
            "1": { "name": "keyword.control.directive.macro.e8085 keyword.control.directive.e8085" },
            "2": { "name": "keyword.control.directive.macro.name.e8085 keyword.control.directive.e8085" },
            "3": { "name": "constant.numeric.decimal.e8085" }
          }
        },
        {
          "match": "(%(?i:end|endif))\\b",
          "name": "keyword.control.directive.macro.end.e8085"
        },
        {
          "match": "(%(?i:ifdef|ifndef))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.conditional.e8085 keyword.control.directive.e8085" },
            "2": { "name": "entity.name.constant.e8085" }
          }
        },
        {
          "match": "(%(?i:if|elif|else))\\b",
          "name": "keyword.control.directive.conditional.e8085 keyword.control.directive.e8085"
        },
        {
          "name": "constant.numeric.decimal.macro.parameter.e8085",
          "match": "%[0-9]+\\b"
        },
        {
          "match": "(%(?i:include))\\s+(<)([^>]*)(>)",
          "captures": {
            "1": { "name": "keyword.control.directive.include.e8085" },
            "2": { "name": "punctuation.definition.string.begin.e8085 string.quoted.other.lt-gt.include.e8085" },
            "3": { "name": "string.quoted.other.lt-gt.include.e8085" },
            "4": { "name": "punctuation.definition.string.end.e8085 string.quoted.other.lt-gt.include.e8085" }
          }
        },
        {
          "match": "(%(?i:include))\\s+(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "keyword.control.directive.include.e8085" },
            "2": { "name": "string.quoted.double.path.include.e8085" }
          }
        },
        {
          "match": "(%(?i:include))\\s+([^\\s;\"'<]+)",
          "captures": {
            "1": { "name": "keyword.control.directive.include.e8085" },
            "2": { "name": "string.unquoted.path.include.e8085" }
          }
        },
        {
          "match": "(%(?i:define))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.e8085" },
            "2": { "name": "entity.name.constant.e8085" }
          }
        },
        {
          "match": "(%(?i:len))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.e8085" },
            "2": { "name": "variable.other.e8085" }
          }
        },
        {
          "name": "keyword.control.directive.e8085",
          "match": "(?i)%(define|repeat|len|include|macro|end|endif|if|elif|else|ifdef|ifndef)\\b"
        }
      ]
    },
    "text_segment": {
      "begin": "(?i)^\\s*(segment|section)\\s+(\\.(text)|text)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.segment.e8085" },
        "2": { "name": "entity.name.section.segment.e8085 storage.type.section.e8085" }
      },
      "end": "(?=(?i)^\\s*(segment|section)\\s+(\\.(data|bss)|data|bss)\\b)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#modular_keywords" },
        { "include": "#characters" },
        { "include": "#strings" },
        { "include": "#types" },
        { "include": "#labels" },
        { "include": "#control_instructions" },
        { "include": "#memory_instructions" },
        { "include": "#mnemonics" },
        { "include": "#macro_calls" },
        { "include": "#registers" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#local_variables" },
        { "include": "#variables" },
        { "include": "#punctuation" }
      ]
    },
    "data_segment": {
      "begin": "(?i)^\\s*(segment|section)\\s+(\\.(data)|data)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.segment.e8085" },
        "2": { "name": "entity.name.section.segment.e8085 storage.type.section.e8085" }
      },
      "end": "(?=(?i)^\\s*(segment|section)\\s+(\\.(text|bss)|text|bss)\\b)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#types" },
        { "include": "#strings" },
        { "include": "#characters" },
        { "include": "#data_var_declarations" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#variables" },
        { "include": "#punctuation" }
      ]
    },
    "bss_segment": {
      "begin": "(?i)^\\s*(segment|section)\\s+(\\.(bss)|bss)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.segment.e8085" },
        "2": { "name": "entity.name.section.segment.e8085 storage.type.section.e8085" }
      },
      "end": "(?=(?i)^\\s*(segment|section)\\s+(\\.(text|data)|text|data)\\b)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#types" },
        { "include": "#data_var_declarations" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#variables" },
        { "include": "#punctuation" }
      ]
    },
    "segments": {
      "patterns": [
        {
          "name": "keyword.control.segment.e8085",
          "match": "(?i)\\b(segment|section)\\b"
        },
        {
          "name": "entity.name.section.segment.e8085 storage.type.section.e8085",
          "match": "(?i)\\.(text|data|bss)\\b"
        }
      ]
    },
    "modular_keywords": {
      "patterns": [
        {
          "match": "^\\s*((?i:global))\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.storage.modifier.e8085" },
            "2": { "name": "entity.name.function.label.global.e8085" },
            "3": { "name": "punctuation.separator.colon.e8085" }
          }
        },
        {
          "match": "^\\s*((?i:global))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.storage.modifier.e8085" },
            "2": { "name": "entity.name.function.label.global.e8085" }
          }
        },
        {
          "match": "^\\s*((?i:extern))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.storage.modifier.e8085" },
            "2": { "name": "entity.name.function.extern.e8085" }
          }
        },
        {
          "name": "keyword.control.storage.modifier.e8085",
          "match": "(?i)\\b(global|extern)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.e8085",
          "match": "(?i)\\b(BYTE|WORD|DB|DW|DS)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*(\\.[a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.function.label.local.e8085" },
            "2": { "name": "punctuation.separator.colon.e8085" }
          }
        },
        {
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.function.label.e8085" },
            "2": { "name": "punctuation.separator.colon.e8085" }
          }
        }
      ]
    },
    "var_declarations": {
      "patterns": [
        {
          "match": "^\\s*(?!(?i:MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL|ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA|ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR|PUSH|POP|IN|OUT|NOP|HLT|EI|DI|RIM|SIM|JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST|GLOBAL|EXTERN|SEGMENT|SECTION)\\b)([a-zA-Z_][a-zA-Z0-9_]*)\\s+((?i:BYTE|WORD|DB|DW|DS))\\b",
          "captures": {
            "1": { "name": "variable.other.declaration.e8085" },
            "2": { "name": "storage.type.e8085" }
          }
        },
        {
          "match": "^\\s*(?!(?i:MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL|ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA|ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR|PUSH|POP|IN|OUT|NOP|HLT|EI|DI|RIM|SIM|JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST|DB|DW|DS|GLOBAL|EXTERN|SEGMENT|SECTION)\\b)([a-zA-Z_][a-zA-Z0-9_]*)\\s+(?=\"[^\"]*\"|'[^']*'|%repeat)",
          "captures": {
            "1": { "name": "variable.other.declaration.e8085" }
          }
        }
      ]
    },
    "data_var_declarations": {
      "patterns": [
        {
          "include": "#var_declarations"
        },
        {
          "match": "^\\s*(?!(?i:MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL|ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA|ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR|PUSH|POP|IN|OUT|NOP|HLT|EI|DI|RIM|SIM|JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST|DB|DW|DS|GLOBAL|EXTERN|SEGMENT|SECTION)\\b)([a-zA-Z_][a-zA-Z0-9_]*)\\s+(?=0[xXbBoO]|[0-9])",
          "captures": {
            "1": { "name": "variable.other.declaration.e8085" }
          }
        }
      ]
    },
    "control_instructions": {
      "patterns": [
        {
          "match": "(?i)\\b(JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO)\\b\\s+(\\.[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.mnemonic.control.flow.e8085" },
            "2": { "name": "entity.name.function.label.local.target.e8085" }
          }
        },
        {
          "match": "(?i)\\b(JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.mnemonic.control.flow.e8085" },
            "2": { "name": "entity.name.function.label.target.e8085" }
          }
        },
        {
          "name": "keyword.operator.mnemonic.control.flow.e8085",
          "match": "(?i)\\b(JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST)\\b"
        }
      ]
    },
    "memory_instructions": {
      "patterns": [
        {
          "match": "(?i)\\b(LDA|STA|LHLD|SHLD)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.mnemonic.datatransfer.e8085" },
            "2": { "name": "variable.other.e8085" }
          }
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "name": "keyword.operator.mnemonic.datatransfer.e8085",
          "match": "(?i)\\b(MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL)\\b"
        },
        {
          "name": "keyword.operator.mnemonic.math.e8085",
          "match": "(?i)\\b(ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA)\\b"
        },
        {
          "name": "keyword.operator.mnemonic.bitwise.e8085",
          "match": "(?i)\\b(ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR)\\b"
        },
        {
          "name": "keyword.operator.mnemonic.stack.e8085",
          "match": "(?i)\\b(PUSH|POP)\\b"
        },
        {
          "name": "keyword.operator.mnemonic.io.e8085",
          "match": "(?i)\\b(IN|OUT)\\b"
        },
        {
          "name": "keyword.operator.mnemonic.control.e8085",
          "match": "(?i)\\b(NOP|HLT|EI|DI|RIM|SIM)\\b"
        }
      ]
    },
    "macro_calls": {
      "patterns": [
        {
          "match": "(?<=:)\\s*(?!(?i:MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL|ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA|ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR|PUSH|POP|IN|OUT|NOP|HLT|EI|DI|RIM|SIM|JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST|DB|DW|DS|GLOBAL|EXTERN|SEGMENT|SECTION|BYTE|WORD)\\b)([a-zA-Z_][a-zA-Z0-9_]*)(?!\\s+((?i:BYTE|WORD|DB|DW|DS))\\b)\\b",
          "captures": {
            "1": { "name": "entity.name.function.macro.call.e8085 keyword.control.directive.macro.call.e8085 keyword.control.directive.e8085" }
          }
        },
        {
          "match": "^\\s*(?!(?i:MOV|MVI|LXI|LDA|STA|LDAX|STAX|LHLD|SHLD|XCHG|XTHL|SPHL|PCHL|ADD|ADI|ADC|ACI|SUB|SUI|SBB|SBI|INR|DCR|INX|DCX|DAD|DAA|ANA|ANI|XRA|XRI|ORA|ORI|CMP|CPI|CMA|CMC|STC|RLC|RRC|RAL|RAR|PUSH|POP|IN|OUT|NOP|HLT|EI|DI|RIM|SIM|JMP|JZ|JNZ|JC|JNC|JP|JM|JPE|JPO|CALL|CZ|CNZ|CC|CNC|CP|CM|CPE|CPO|RET|RZ|RNZ|RC|RNC|RP|RM|RPE|RPO|RST|DB|DW|DS|GLOBAL|EXTERN|SEGMENT|SECTION|BYTE|WORD)\\b)([a-zA-Z_][a-zA-Z0-9_]*)(?!\\s+((?i:BYTE|WORD|DB|DW|DS))\\b)\\b",
          "captures": {
            "1": { "name": "entity.name.function.macro.call.e8085 keyword.control.directive.macro.call.e8085 keyword.control.directive.e8085" }
          }
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "storage.type.register.memory.e8085 variable.language.register.memory.e8085",
          "match": "(?i)\\bM\\b"
        },
        {
          "name": "storage.type.register.psw.e8085 variable.language.register.psw.e8085",
          "match": "(?i)\\bPSW\\b"
        },
        {
          "name": "storage.type.register.sp.e8085 variable.language.register.sp.e8085",
          "match": "(?i)\\bSP\\b"
        },
        {
          "name": "storage.type.register.pair.e8085 variable.language.register.pair.e8085",
          "match": "(?i)\\b(BC|DE|HL)\\b"
        },
        {
          "name": "storage.type.register.accumulator.e8085 variable.language.register.accumulator.e8085",
          "match": "(?i)\\bA\\b"
        },
        {
          "name": "storage.type.register.8bit.e8085 variable.language.register.8bit.e8085",
          "match": "(?i)\\b(B|C|D|E|H|L)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "entity.name.constant.e8085",
          "match": "\\b[A-Z_][A-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.e8085",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.e8085",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.e8085",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.e8085",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.e8085",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.e8085",
              "match": "\\\\([nrt0\\\\\"'xX]|x[0-9a-fA-F]{2}|.)"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.language.character.literal.e8085",
          "match": "'([^'\\\\]|(\\\\([nrt0\\\\\"'xX]|x[0-9a-fA-F]{2}|.)))'",
          "captures": {
            "2": { "name": "constant.character.escape.e8085" }
          }
        }
      ]
    },
    "local_variables": {
      "patterns": [
        {
          "name": "entity.name.function.label.local.e8085 variable.other.local.e8085",
          "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.e8085",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.e8085",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.e8085",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "punctuation.separator.comma.e8085",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.e8085",
          "match": ":"
        }
      ]
    }
  }
}
