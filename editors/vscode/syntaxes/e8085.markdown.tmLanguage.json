{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "e8085 Markdown Codeblock",
  "scopeName": "markdown.e8085.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(e8085))\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.e8085",
      "patterns": [
        {
          "include": "source.e8085"
        }
      ]
    }
  ]
}
