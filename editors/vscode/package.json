{
  "name": "e8085-assembly",
  "displayName": "8085 Assembly (e8085)",
  "description": "Syntax highlighting and language support for 8085 Assembly (.e8085)",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "e8085",
        "aliases": [
          "8085 Assembly",
          "e8085"
        ],
        "extensions": [
          ".e8085"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "e8085",
        "scopeName": "source.e8085",
        "path": "./syntaxes/e8085.tmLanguage.json"
      }
    ]
  }
}
