{
  "name": "e8085-assembly",
  "displayName": "8085 Assembly (e8085)",
  "description": "Syntax highlighting and language support for 8085 Assembly (.e8085)",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:e8085",
    "onLanguage:markdown",
    "onDebug"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdown-preview.css"
    ],
    "languages": [
      {
        "id": "e8085",
        "aliases": [
          "e8085"
        ],
        "extensions": [
          ".e8085"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "e8085",
        "scopeName": "source.e8085",
        "path": "./syntaxes/e8085.tmLanguage.json"
      },
      {
        "scopeName": "markdown.e8085.codeblock",
        "path": "./syntaxes/e8085.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.e8085": "e8085"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "e8085"
      }
    ],
    "debuggers": [
      {
        "type": "e8085",
        "label": "8085 Debugger",
        "languages": [
          "e8085"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .e8085 assembly source file to assemble and debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after loading program at entry point PC.",
                "default": true
              },
              "includePaths": {
                "type": "array",
                "description": "Additional include directories for %include search.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "linkLibraries": {
                "type": "array",
                "description": "Pre-compiled library containers (.e8085) to link with.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "console": {
                "type": "string",
                "enum": [
                  "integratedTerminal",
                  "internalConsole",
                  "externalTerminal"
                ],
                "description": "Where to launch the debug target and interactive terminal (default: integratedTerminal).",
                "default": "integratedTerminal"
              },
              "terminalPort": {
                "type": "number",
                "description": "TCP port for the 8085 integrated terminal bridge (default: 8085).",
                "default": 8085
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "e8085",
            "name": "Debug 8085 Assembly",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
          }
        ],
        "configurationSnippets": [
          {
            "label": "8085: Debug Current File",
            "description": "A launch configuration for debugging the currently active 8085 assembly file",
            "body": {
              "type": "e8085",
              "name": "Debug 8085 (${fileBasename})",
              "request": "launch",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true,
              "console": "integratedTerminal",
              "internalConsoleOptions": "neverOpen"
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "8085 Assembly",
      "properties": {
        "e8085.serverPath": {
          "type": "string",
          "default": "e8085-lsp",
          "description": "Path to the e8085-lsp binary (defaults to 'e8085-lsp' on PATH or cargo target/debug/e8085-lsp)"
        },
        "e8085.dapServerPath": {
          "type": "string",
          "default": "e8085-dap",
          "description": "Path to the e8085-dap binary (defaults to 'e8085-dap' on PATH or cargo target/debug/e8085-dap)"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
