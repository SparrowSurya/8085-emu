{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["\"", "\""],
    ["'", "'"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*%(?i:macro)\\b",
      "end": "^\\s*%(?i:end)\\b"
    }
  },
  "wordPattern": "(%[0-9]+)|(%[a-zA-Z_][a-zA-Z0-9_]*)|(\\.[a-zA-Z_][a-zA-Z0-9_]*)|([a-zA-Z_][a-zA-Z0-9_]*)"
}
