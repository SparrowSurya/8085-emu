; =================================================================
; 8085 STRING & INTEGER CONVERSION SUBROUTINES
; Includes: to_uint8 (string -> 8-bit int), to_str8 (8-bit int -> string)
; Requires: math.8085.bin (for divide)
; =================================================================


segment .text

    global to_uint8
    global to_str8

    extern divide


; -----------------------------------------------------------------
; SUBROUTINE: to_uint8
; Description: Converts an ASCII decimal string to an 8-bit unsigned integer.
; Args:        HL = Address of ASCII string buffer
;              B  = Number of characters in string
; Returns:     A  = 8-bit unsigned integer result (0..255)
; Alters:      A, B, C, D, E, HL
; -----------------------------------------------------------------
to_uint8:
    mov A, B        ; Check if string length is 0
    cpi 0x00
    jz .empty_str

    mvi C, 0x00   ; C = running integer result accumulator

.loop:
    mov A, M   ; A = current ASCII character from [HL]
    sui 0x30   ; Convert ASCII ('0'..'9') to numeric (0..9)
    mov E, A   ; Save current digit in E

    ; Calculate C = C * 10
    mov A, C   ; A = C
    add A      ; A = C * 2
    add A      ; A = C * 4
    add C      ; A = C * 5
    add A      ; A = C * 10
    add E      ; A = C * 10 + digit
    mov C, A   ; Update result in C

    inx HL      ; Advance string pointer
    dcr B       ; Decrement character count
    jnz .loop

    mov A, C   ; Place final integer in return register A
    ret

.empty_str:
    mvi A, 0x00   ; Return 0 for empty string
    ret


; -----------------------------------------------------------------
; SUBROUTINE: to_str8
; Description: Converts an 8-bit unsigned integer to an ASCII decimal string.
; Args:        HL = Address of destination buffer
;              A  = 8-bit unsigned integer (0..255)
; Returns:     B  = Length of the generated ASCII string (1..3)
;              A  = Length of the generated ASCII string (1..3)
; Alters:      A, B, C, D, E, HL
; -----------------------------------------------------------------
to_str8:
    cpi 0x00        ; Check if input is 0
    jnz .non_zero

    mvi A, 0x30   ; Store ASCII '0'
    mov M, A
    mvi B, 0x01   ; Length = 1
    mvi A, 0x01
    ret

.non_zero:
    mvi E, 0x00   ; E = digit counter (number of digits pushed)

.div_loop:
    push DE       ; Save digit counter across subroutine call
    mov B, A      ; B = Dividend
    mvi A, 0x0A   ; A = Divisor (10)
    call divide   ; Inputs: B=Dividend, A=Divisor -> Outputs: C=Quotient, D=Remainder
    pop DE        ; Restore digit counter (E)
    inr E         ; Increment digit counter

    mov A, D   ; A = Remainder digit (0..9)
    adi 0x30   ; Convert to ASCII character
    push PSW   ; Push ASCII character onto stack

    mov A, C        ; A = Quotient
    cpi 0x00        ; If quotient != 0, continue dividing
    jnz .div_loop

    ; Write characters from stack into buffer at HL (left to right)
    mov B, E   ; B = total string length
    mov C, E   ; C = loop counter for writing characters

.write_loop:
    pop PSW           ; Pop most significant digit first
    mov M, A          ; Write character to buffer [HL]
    inx HL            ; Advance buffer pointer
    dcr C             ; Decrement character counter
    jnz .write_loop

    mov A, B   ; Return length in A as well
    ret
