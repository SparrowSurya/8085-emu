; Demonstration of static expression evaluation in %define directives
%define ROWS 10
%define COLS 12
%define CELLS ROWS*COLS
%define HALF_CELLS CELLS / 2
%define MASK (1 << 3) | (1 << 5)
%define SHIFT 32 >> 2
%define XOR_VAL 0xFF ^ 0x0F
%define MOD_VAL 10 % 3

segment .data
grid_size BYTE CELLS

segment .bss
buffer BYTE HALF_CELLS

segment .text
main:
    mvi A, CELLS
    mvi B, MASK
    mvi C, SHIFT
    mvi D, XOR_VAL
    mvi E, MOD_VAL
    hlt
